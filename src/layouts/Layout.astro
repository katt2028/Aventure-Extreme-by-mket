---
import { Icon } from "astro-icon/components";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Aventure Extreme by mket</title>
	</head>

	<body>
		<header class="flex justify-between px-13 py-6 items-center">
			<p class="text-4xl font-bold text-amber-800">Aventure Extreme</p>

			<div class="flex gap-7">
				<li>
					<a href="/" class="text-2xl font-extrabold text-amber-950"
						>Home</a
					>
				</li>
				<li>
					<a
						href="/rutasytours"
						class="text-xl font-extrabold text-amber-950"
						>Rutas y Tours</a
					>
				</li>
				<li>
					<a
						href="/nuestraflota"
						class="text-xl font-extrabold text-amber-950"
						>Nuestra Flota</a
					>
				</li>
				<li>
					<a
						href="/reservaycontacto"
						class="text-xl font-extrabold text-amber-950"
						>Reserva y Contacto</a
					>
				</li>
			</div>

			<div>
				<button
					class="text- font-serif text-amber-950 bg-amber-500 px-6 py-3
					rounded-full"
					>Reserva Ahora</button
				>
			</div>
		</header>

		<slot />
	</body>
</html>
