<section class="flex items-center bg-amber-100">
    <div class="py-11 px-11 flex gap-6 items-center flex-1">
        <img src="/fondoe.jpg" alt="" />
    </div>
    <div class="flex-1">
        <button
            class="flex px-5 text-lg   text-white
                    bg-amber-900 rounded-full px-3 ml-4 py-2"
        >
            ESPECIAL DE TEMPORADA
        </button>
        <div class="px-4 ml-3 py-3">
            <p class="text-6xl font-bold text-amber-950">LA CARRERA</p>
            <p class="text-6xl font-bold text-amber-600">DE LA MEDIANOCHE</p>
        </div>
        <p class="text-2xl   px-5 ml-3 py-3">
            Experience the Valencian wild under the stars. This exclusive night
            tour uses high-powered LED arrays to illuminate the trail in a way
            you´ve never seen before. A truly cinematic adventure.
        </p>
        <!-- comentario falta encerrarlas en una cajita como la macima altitud -->
        <div class="space-y-10">
            <div class=" flex">
                <div class="flex-1 text-xl   px-5 ml-3 py-5 rounded-2xl bg-amber-50 ">
                    <p class="uppercase font-semibold">Horarios</p>
                    <p class=" text-4xl text-amber-950">7am - 11pm</p>
                </div>
    
                <div class="flex-1 text-xl   px-5 ml-3 py-5 rounded-2xl bg-amber-50 ">
                    <p class="uppercase font-semibold">Ritmo de aventura</p>
                    <p class=" text-4xl text-amber-950 ">Siempre Disponible</p>
                </div>
                
            </div>

            <button
                class="text-3xl   text-white
                    bg-amber-900 rounded-full px-14 ml-5 py-4"
                >Reserva tu experiencia de visita nocturna por tan solo $34.99
            </button>
        </div>
    </div>
    <!-- comentario esto falta por detallar, luego por supuesto las otras dos pages -->
</section>
<section class="flex-2 text-xl   px-3 ml-3 py-3">
    <div>
        <p class="text-6xl font-bold text-amber-950">Explora los circuitos</p>
        <p>
            Nuestras rutas cubren más de 90-120 km de terreno diverso. Desde
            ascensos técnicos y empinados hasta senderos abiertos y rápidos, hay
            un sendero para cada ciclista.
        </p>
    </div>

    <div>
        falta icon brujula
        <button>SEGUIMIENTO GPS EN TIEMPO REAL</button>
        <p>Siempre guiado por telemetría en tiempo real.</p>
    </div>

    <div>
        falta icon escudo
        <button>PROTECCIÓN PREMIUM</button>
        <p>Siempre guiado por telemetría en tiempo real.</p>
    </div>

    <button>ACCESO AL MAPA COMPLETO EN TIEMPO REAL</button>
</section>
