---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <section>
        <div>
            <p>Choose Your Path</p>
            <p>Unleash the power in Valencia</p>
            <p>
                Turn heads from Prebo to Guaparo. More speed, less stress, and
                all the flow you need to conquer the city
            </p>
        </div>
        <div>
            <img src="/primerafoto.png" alt="" />
        </div>
    </section>

    <section class="flex text-xl">
        <button> All Tours</button>
        <button> Mountain Adventure </button>
        <button> Sunset Expeditions</button>
        <button> Family Friendly </button>
    </section>

    <section>
        <!-- esta es la primera tarjeta -->
        <div>
            <div>
                <div>
                    <p>Expert</p>
                    <p>Toprated</p>
                </div>
                <img src="/fondoa" alt="" />
            </div>

            <div>
                <p>Cerro El Cafe</p>
                <div>
                    <p>4 Hours</p>
                    <p>Technical</p>
                </div>
            </div>

            <div>
                <div>
                    <p>Starting From</p>
                    <p>$149.3</p>
                </div>
                <button> Iconoflecha</button>
            </div>
        </div>

        <!-- esta es la segunda tarjeta -->
        <div>
            <div>
                <div>
                    <p>Begginer</p>
                </div>
                <img src="/fondob" alt="" />
            </div>

            <div>
                <p>Playa Waikiki</p>
                <div>
                    <p>2.5 Hours</p>
                    <p>Scenic</p>
                </div>
            </div>

            <div>
                <div>
                    <p>Starting From</p>
                    <p>48.6</p>
                </div>
                <button> Iconoflecha</button>
            </div>
        </div>

        <!-- esta es la tercera tarjeta -->
        <div>
            <div>
                <div>
                    <p>Intermediate</p>
                </div>
                <img src="/fondoc" alt="" />
            </div>

            <div>
                <p>Centro Sambil Valencia</p>
                <div>
                    <p>3 Hours</p>
                    <p>City</p>
                </div>
            </div>

            <div>
                <div>
                    <p>Starting From</p>
                    <p>37.6</p>
                </div>
                <button> Iconoflecha</button>
            </div>
        </div>

        <!-- esta es la cuarta tarjeta -->
        <div>
            <div>
                <div>
                    <p>All levels</p>
                </div>
                <img src="/fondod" alt="" />
            </div>

            <div>
                <p>Unlock</p>
                <div>
                    <p>12 Hours</p>
                    <p>Sunset</p>
                </div>
            </div>

            <div>
                <div>
                    <p>Starting From</p>
                    <p>248</p>
                </div>
                <button> Iconoflecha</button>
            </div>
        </div>
    </section>

    <section>
        <div>
            <img src="fondoe" alt="" />
        </div>

        <div>
            <!-- Aqui es donde va el resto del contenido -->
            <p>Seasonal Special</p>

            <p>The Midnight Moon Run</p>
            <p>
                Experience the Valencian wild under the stars. This exclusive
                night tour uses high-powered LED arrays to illuminate the trail
                in a way you´ve never seen before. A truly cinematic adventure.
            </p>

            <div>
                <div>
                    <p>Departure Time</p>
                    <p>9am - 12pm</p>
                </div>

                <div>
                    <p>Adventure Pace</p>
                    <p>Steady Flow</p>
                </div>

                <button>Book Night Tours Experience -$35</button>
            </div>
        </div>

        <section class="flex text-amber-100">
            <div>
                <p>Explore the circuit</p>
                <p>
                    Our routes cover over 90-120km of diverse terrain. From
                    technical steep climbs to fast open paths, there is a trail
                    every rider.
                </p>
            </div>

                <div>
                    falta icon brujula
                    <button>LIVE GPS TRACKING</button>
                    <p>Always guided by real-time telemetry</p>
                </div>

                <div>
                    falta icon escudo
                    <button>PREMIUM PROTECTION</button>
                    <p>Always guided by real-time telemetry</p>
                </div>

                <button>FULL MAP ACCESS</button>
        </section>
    </section></Layout
>
