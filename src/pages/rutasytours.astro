---
import Tarjeta1 from "../components/Tarjeta1.astro";
import Layout from "../layouts/Layout.astro";
import { Icon } from 'astro-icon/components'

const Destinos = [
    {
        titulo: "Cerro El Cafe",
        subtitle: "1 Hora Exclusiva",
        price: "60",
        img: "/fondoa.png",
        nivel: "Experto",
    },
    {
        titulo: "Playa Waikiki",
        subtitle: "1 Hora Escenica",
        price: "43",
        img: "/fondob.jpg",
        nivel: "Principiante",
    },
    {
        titulo: "Centro Comercial Sambil",
        subtitle: "1 Hora Ciudad",
        price: "39",
        img: "/fondoc.png",
        nivel: "Intermedio",
    },
    {
        titulo: "Descubrir Valencia",
        subtitle: "12 Horas Eventos",
        price: "118.3",
        img: "/fondod.png",
        nivel: "Todos los niveles",
    },
];
---

<Layout>
    <section class="py-11 px-11 flex gap-6 items-center">
        <div>
            <button
                class="text-lg text-ambar-950 bg-amber-500
           px-4 py-2 rounded-full"
                >ELIGE TU CAMINO</button
            >

            <p class="text-8xl font-bold text-amber-950">DESATA EL</p>
            <p class="text-9xl text-amber-600">PODER</p>
            <p class="text-8xl font-bold text-amber-950">EN VALENCIA</p>

            <p class="text-2xl px- py-8">
                Captura todas las miradas desde Prebo hasta Guaparo. Más
                velocidad, menos estrés y toda la fluidez que necesitas para
                conquistar la ciudad.
            </p>
        </div>

        <div>
            <img src="/primerafoto.png" alt="" />
        </div>
    </section>

    <section class="flex text-xl px-8 ml-5 py-10 gap-4">
        <button
            class="space-y-20 text-2xl text-black bg-amber-100
                 px-6 ml-4 py-2 rounded-full"
            >Todos los tours</button
        >

        <button
            class="space-y-20 text-2xl text-black bg-amber-100
                 px-6 ml-4 py-2 p rounded-full"
            >Aventura de montaña</button
        >

        <button
            class="space-y-20 text-2xl text-black bg-amber-100
                 px-6 ml-4 py-2 rounded-full"
            >Expediciones al atardecer</button
        >

        <button
            class="space-y-20 text-2xl text-black bg-amber-100 items-between
                 px-6 ml-4 py-2 rounded-full"
            >Ideal para compatir en familia</button
        >
    </section>

    <section class="flex text-2xl font-bold px-7 gap-6 flex-wrap py-10">
        {
            Destinos.map((destino) => (
                <Tarjeta1
                    titulo={destino.titulo}
                    subtitle={destino.subtitle}
                    price={destino.price}
                    img={destino.img}
                    nivel={destino.nivel}
                />
            ))
        }

        <!-- esta es la segunda tarjeta -->
