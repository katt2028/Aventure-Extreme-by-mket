            </div>

            <div>
                <p>Playa Waikiki</p>
                <div>
                    <p>40 Minutos</p>
                    <p>Escenico</p>
                </div>
            </div>

            <div>
                <div>
                    <p>A partir de</p>
                    <p>$35</p>
                </div>
                <button
                    class="text-l font-bold text-white bg-mauve-400
                 px-4 py-2 rounded-full"
                    >Icono flecha</button
                >
            </div>
        </div> -->

