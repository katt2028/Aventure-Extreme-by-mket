---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <section>
        <div>
            <button
                class="text-lg text-ambar-950 bg-amber-500
           px-4 py-2 rounded-full p-5"
                >ENCIENDE TU MOTOR</button
            >

            <p class="text-8xl font-bold text-amber-950 px-5 ml-4 py-4">
                ¿LISTO PARA
            </p>
            <p class="text-9xl text-amber-600 px-5 ml-4 py-1">ENSUCIARTE?</p>

            <p class="text-2xl px-5 ml-4 py-8">
                Elige tu ruta por los escarpados senderos valencianos. Tanto si
                prefieres un paseo al atardecer como una aventura en el barro,
                tenemos el quad y el guía esperándote.
            </p>
        </div>
    </section>
</Layout>
